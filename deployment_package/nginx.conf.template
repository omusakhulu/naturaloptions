# ============================================================================
# Nginx Reverse Proxy Configuration for Natural Options Admin Dashboard
# Next.js 15.1.2 + PM2 Cluster Mode (2 instances) on port 3010
# ============================================================================
#
# INSTALLATION INSTRUCTIONS:
# 1. Copy this file to /etc/nginx/sites-available/naturaloptions
# 2. Replace all CHANGEME placeholders with actual values
# 3. Create symlink: ln -s /etc/nginx/sites-available/naturaloptions /etc/nginx/sites-enabled/
# 4. Test config: nginx -t
# 5. Reload Nginx: systemctl reload nginx
#
# CHANGEME PLACEHOLDERS:
# - server_name: Replace with your domain (e.g., admin.example.com) or VPS IP (167.86.108.197)
# - BASEPATH: If app is served at /admin, set location /admin { ... }, otherwise use location / { ... }
# - SSL certificate paths: Update with actual Let's Encrypt paths when SSL is configured
# ============================================================================

# Rate limiting zone for authentication endpoints
# Limit: 5 requests/second per IP, burst up to 10 requests
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=5r/s;

# Upstream definition for Next.js PM2 cluster
upstream nextjs_backend {
    # PM2 cluster mode runs 2 instances on same port with load balancing
    server 127.0.0.1:3010 max_fails=3 fail_timeout=30s;

    # Keep connections alive to reduce overhead
    keepalive 32;
}

# ============================================================================
# HTTP Server Block (Active)
# ============================================================================
server {
    listen 80;
    listen [::]:80;

    # CHANGEME: Replace with your domain or VPS IP
    server_name 167.86.108.197;
    # Example with domain: server_name admin.example.com;

    # Server identification
    server_tokens off;  # Hide Nginx version

    # Max request body size (50MB for file uploads)
    client_max_body_size 50M;

    # Request timeouts
    client_body_timeout 30s;
    client_header_timeout 30s;

    # Access and error logs
    access_log /var/log/nginx/naturaloptions_access.log;
    error_log /var/log/nginx/naturaloptions_error.log warn;

    # Don't log health check requests (reduces log noise)
    location = /api/health {
        access_log off;
        proxy_pass http://nextjs_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # ========================================================================
    # Security: Deny access to dotfiles and sensitive files
    # ========================================================================
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
        return 404;
    }

    location ~ /\.(env|git|vscode|idea|DS_Store)$ {
        deny all;
        access_log off;
        log_not_found off;
        return 404;
    }

    # ========================================================================
    # Next.js Static Assets (_next/static/) with aggressive caching
    # ========================================================================
    location /_next/static/ {
        proxy_pass http://nextjs_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # Cache for 1 year (Next.js content hashes make these immutable)
        expires 365d;
        add_header Cache-Control "public, immutable";

        # Security headers
        add_header X-Content-Type-Options "nosniff" always;

        # Optional: If using BASEPATH, adjust proxy_pass
        # Example: proxy_pass http://nextjs_backend/admin/_next/static/;
    }

    # ========================================================================
    # Next.js Image Optimization (_next/image)
    # ========================================================================
    location /_next/image {
        proxy_pass http://nextjs_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # Cache optimized images for 30 days
        expires 30d;
        add_header Cache-Control "public, immutable";

        # Security headers
        add_header X-Content-Type-Options "nosniff" always;

        # Increase timeout for image processing
        proxy_read_timeout 60s;
    }

    # ========================================================================
    # Rate Limited Authentication Endpoints
    # ========================================================================
    location /api/auth/ {
        # Apply rate limiting: 5 req/s, burst 10, return 429 if exceeded
        limit_req zone=auth_limit burst=10 nodelay;
        limit_req_status 429;

        proxy_pass http://nextjs_backend;
        proxy_http_version 1.1;

        # Proxy headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # Timeouts
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # ========================================================================
    # Main Application Proxy (Root or BASEPATH)
    # ========================================================================
    # CHANGEME: If app uses BASEPATH (e.g., /admin), change this to:
    # location /admin/ {
    #     rewrite ^/admin(/.*)$ $1 break;
    #     proxy_pass http://nextjs_backend;
    #     ...
    # }

    location / {
        proxy_pass http://nextjs_backend;
        proxy_http_version 1.1;

        # Essential proxy headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support (required for Next.js HMR in dev, useful for future features)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Timeouts
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;

        # Buffering settings
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;

        # Security headers (complementing app's middleware)
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Robots-Tag "noindex, nofollow" always;  # Admin dashboard should not be indexed

        # Note: App already sets these via middleware:
        # - X-Frame-Options: DENY
        # - X-XSS-Protection: 1; mode=block
        # - Referrer-Policy: strict-origin-when-cross-origin
        # - Permissions-Policy
    }
}

