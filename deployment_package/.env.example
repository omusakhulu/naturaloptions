# WooCommerce Configuration
WOO_STORE_URL=https://your-woocommerce-store.com
WOO_CONSUMER_KEY=your_consumer_key_here
WOO_CONSUMER_SECRET=your_consumer_secret_here

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/naturaloptions?schema=public

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_secret_here

# Environment
NODE_ENV=development
